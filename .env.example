# ====================================================================
# EVALORA ENTERPRISE ASSESSMENT CLOUD - ENVIRONMENT CONFIGURATION
# ====================================================================

# Database
DATABASE_URL=postgresql://evalora:evalora_secure_password@localhost:5432/evalora_db
# For local dev without Postgres: sqlite:///./evalora.db

# JWT Authentication & RBAC
JWT_SECRET=evalora-super-secure-production-jwt-key-32chars-minimum-hash
JWT_REFRESH_SECRET=evalora-super-secure-refresh-jwt-key-32chars-minimum-hash
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7
EXAM_ACCESS_TOKEN_EXPIRE_MINUTES=240

# Redis Cache & Background Tasks
REDIS_URL=redis://localhost:6379/0

# AI Subjective Evaluation (LLM)
OPENAI_API_KEY=sk-your-openai-api-key-here
LLM_MODEL=gpt-4o-mini

# Proctoring Suspicion Algorithm Defaults
PROCTORING_HEARTBEAT_SECONDS=10
FACE_ABSENCE_PENALTY=10
MULTIPLE_FACES_PENALTY=25
GAZE_AWAY_PENALTY=10
TAB_SWITCH_PENALTY=15
WINDOW_BLUR_PENALTY=10
FULLSCREEN_EXIT_PENALTY=15

# Object Storage / S3 (For Handwritten & Image Answers)
S3_ENDPOINT=https://s3.amazonaws.com
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key
S3_BUCKET=evalora-answers-storage

# Frontend Public API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
